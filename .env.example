# Локальная база SQLite
DATABASE_PATH=wedding.db
PORT=3001
# Замените оба значения на длинные случайные строки.
SANDBOX_SECRET=replace-with-long-random-string
ADMIN_ACCESS_CODE=replace-with-separate-admin-code
# Каталог медиабиблиотеки при локальном хранении.
MEDIA_PATH=public/uploads

# Необязательно: S3-совместимое хранилище. Без полного набора ключей используется MEDIA_PATH.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# Необязательно: тестовый магазин ЮKassa. Без ключей работает локальный sandbox.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
